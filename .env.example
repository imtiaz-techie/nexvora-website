# Public site URL (used for SEO metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# SMTP settings for the contact form.
# If SMTP_HOST is empty, submissions are validated and logged to the server console only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Address that receives enquiries, and the "from" address used when sending
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
